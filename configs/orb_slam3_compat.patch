+KeyFrame* System::GetTrackingReferenceKeyFrame()
+{
+    return mpTracker->mCurrentFrame.mpReferenceKF;
+}
+
+void System::SaveKeyFrameGraphCSV(const string &filename)
+{
+    ofstream output(filename.c_str());
+    output << "map_id,keyframe_id,timestamp,tx,ty,tz,qx,qy,qz,qw\n";
+    for(Map* map : mpAtlas->GetAllMaps())
+    {
+        if(!map || map->IsBad()) continue;
+        vector<KeyFrame*> keyframes = map->GetAllKeyFrames();
+        sort(keyframes.begin(), keyframes.end(), KeyFrame::lId);
+        for(KeyFrame* keyframe : keyframes)
+        {
+            if(!keyframe || keyframe->isBad()) continue;
+            Sophus::SE3f pose = keyframe->GetPoseInverse();
+            Eigen::Vector3f position = pose.translation();
+            Eigen::Quaternionf orientation = pose.unit_quaternion();
+            output << setprecision(10) << map->GetId() << ',' << keyframe->mnId << ','
+                   << keyframe->mTimeStamp << ',' << position(0) << ',' << position(1) << ','
+                   << position(2) << ',' << orientation.x() << ',' << orientation.y() << ','
+                   << orientation.z() << ',' << orientation.w() << '\n';
+        }
+    }
+}
